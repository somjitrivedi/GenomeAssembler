{
  "name": "genome-assembler",
  "version": "0.1.0",
  "private": true,
  "description": "De novo short-read genome assembler: k-mer counting, de Bruijn graphs, error correction, bubble removal and paired-end scaffolding",
  "type": "module",
  "bin": {
    "genome-assembler": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ga": "tsx src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
